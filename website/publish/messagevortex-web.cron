# /etc/cron.d/messagevortex-web - publish https://messagevortex.net (see website/publish/publish-osiris.sh)
# The script only rebuilds when main, development or the GitHub releases changed.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
*/5 * * * * root /usr/local/sbin/messagevortex-publish >>/var/log/messagevortex-publish.log 2>&1
